# Copy to server/.env and fill in
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Origins allowed to open the WebSocket (comma-separated)
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
# In production set NODE_ENV=production (session cookie gets the Secure flag; serve via HTTPS)
# Lifetime of the access token in seconds (default 900 = 15 min)
ACCESS_TOKEN_TTL_SECONDS=900
